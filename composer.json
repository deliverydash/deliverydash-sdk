{
    "name": "deliverydash/php-sdk",
    "description": "Official PHP SDK for DeliveryDash API integration",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "DeliveryDash",
            "email": "developers@deliverydash.co.za"
        }
    ],
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "squizlabs/php_codesniffer": "^3.6"
    },
    "autoload": {
        "psr-4": {
            "DeliveryDash\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DeliveryDash\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}